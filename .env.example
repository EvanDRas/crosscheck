# Copy this file to .env and fill in your key. .env is gitignored — keys never ship to the browser or the repo.

# Free key from https://finnhub.io (Dashboard -> API Keys). Free tier = 60 calls/min.
FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional but recommended: free key from https://tiingo.com (Account -> API).
# Powers price charts, total-return ledger grading, and the Time Machine. Free-tier limits apply; everything degrades without it.
#TIINGO_API_KEY=your_tiingo_api_key_here

# Contact for the SEC EDGAR User-Agent (their fair-access policy asks who is
# calling). EDGAR fundamentals need no key — public-domain data.
#SEC_EDGAR_CONTACT=you@example.com

# Optional: "Ask the data" — the in-app AI explainer. Give it a brain one of
# two ways (no Ollama + no key = the feature stays off, everything else works):
#   1. Free and local: install https://ollama.com and pull a model —
#      `ollama pull qwen3:14b` on a gaming GPU (12GB VRAM),
#      `ollama pull llama3.1:8b` or `llama3.2:3b` on lighter machines.
#      Crosscheck detects it automatically; nothing leaves your PC.
#   2. An Anthropic API key from https://console.anthropic.com (paid; a
#      question costs a fraction of a cent on the default Haiku model).
# Which local Ollama model to use (default: the first one installed).
#OLLAMA_MODEL=qwen3:14b
# Where Ollama listens, if not the default.
#OLLAMA_URL=http://127.0.0.1:11434
#ANTHROPIC_API_KEY=sk-ant-your_key_here
# Which Claude model to use (default: claude-haiku-4-5-20251001; set
# claude-sonnet-5 for better answers at a higher per-question cost).
#ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional. Port the server listens on.
PORT=3000

# Optional: local price-history datasets (a daily adjusted-close panel and/or
# a Tiingo parquet archive). Most users should skip these — with a Tiingo API
# key the chart works without any local data. Requires Python with pyarrow.
#HISTORY_PRICES_PARQUET=C:\path\to\your\prices_panel.parquet
#HISTORY_TIINGO_DIR=C:\path\to\your\tiingo_archive
#PYTHON_BIN=python
